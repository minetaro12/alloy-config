declare "monitor" {
  prometheus.exporter.unix "host" {
    enable_collectors = ["systemd"]
  }

  prometheus.scrape "node" {
    job_name        = "node"
    targets         = prometheus.exporter.unix.host.targets
    scrape_interval = "15s"

    forward_to = [
      prometheus.remote_write.central.receiver,
    ]
  }

discovery.file "minecraft" {
  files = ["/etc/alloy/targets/minecraft*.json"]
  refresh_interval = "30s"
}

prometheus.scrape "minecraft" {
  job_name = "minecraft"
  targets  = discovery.file.minecraft.targets

  scrape_interval = "15s"

  forward_to = [
    prometheus.remote_write.central.receiver,
  ]
}

  prometheus.remote_write "central" {
    endpoint {
      url = "https://monitor.osanlab.jp/vm/api/v1/write"

      basic_auth {
        username = "alloy"
        password_file = "/etc/alloy/monitor_password"
      }
    }
  }

  loki.relabel "journal" {
    forward_to = []

    // システムユニット
    rule {
      source_labels = ["__journal__systemd_unit"]
      target_label  = "unit"
    }

    // ユーザーユニット
    rule {
      source_labels = ["__journal__systemd_user_unit"]
      target_label  = "user_unit"
    }

    // ログレベル
    rule {
      source_labels = ["__journal_priority_keyword"]
      target_label  = "level"
    }

    // syslog識別子
    rule {
      source_labels = ["__journal_syslog_identifier"]
      target_label  = "syslog_identifier"
    }

    // ログの取得経路
    rule {
      source_labels = ["__journal__transport"]
      target_label  = "transport"
    }

    // 追加: サービス名を共通化
    rule {
      source_labels = ["__journal__systemd_unit"]
      regex         = "(.+)"
      target_label  = "service_name"
    }

    rule {
      source_labels = ["__journal__systemd_user_unit"]
      regex         = "(.+)"
      target_label  = "service_name"
    }
  }

  loki.source.journal "system" {
    forward_to = [
      loki.write.central.receiver,
    ]

    relabel_rules = loki.relabel.journal.rules

    labels = {
      source = "journal",
    }
  }

  loki.write "central" {
    external_labels = {
      instance = constants.hostname,
    }

    endpoint {
      url = "https://monitor.osanlab.jp/loki/api/v1/push"

      basic_auth {
        username = "alloy"
        password_file = "/etc/alloy/monitor_password"
      }
    }
  }
}
declare "monitor" {
